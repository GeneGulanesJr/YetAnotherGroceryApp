# Expo SDK 57 ships a `react@19.2.3` peer constraint, while transitive
# deps in `@clerk/expo@4.x` and Expo's dev pipeline already target
# `react@~19.3.0-0`. The strict resolver rejects the install; falling
# back to pre-v7 behaviour (warn instead of abort) is what Expo
# recommends for SDK 57 + Clerk projects, what `npm install` does
# locally, and what regenerated the lockfile in this repo.
#
# `npm ci` reads this file automatically on every CI run as well as on
# developer machines — no workflow edit required.
legacy-peer-deps=true