{
  "expo": {
    "name": "YetAnotherGroceryApp",
    "slug": "genegulanes",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "yaga",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yetanothergroceryapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "YetAnotherGroceryApp uses the camera to scan barcodes and capture shelf prices and receipts.",
        "NSPhotoLibraryUsageDescription": "YetAnotherGroceryApp can access your photo library to import product, shelf, and receipt photos."
      }
    },
    "android": {
      "package": "com.yetanothergroceryapp.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#1E8F86"
      }
    },
    "extra": {
      "eas": {
        "projectId": "15bd877b-8763-4ff6-9189-f51a6ec41924"
      },
      "apiBaseUrl": ""
    },
    "owner": "genegulanesjrs-team",
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/BricolageGrotesque_400Regular.ttf",
              "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
              "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "YetAnotherGroceryApp can access your photo library to import product photos."
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1E8F86",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0F2226"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#CFEAE5"
  }
}
