{
  "expo": {
    "name": "YetAnotherGroceryApp",
    "slug": "genegulanes",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "yaga",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yetanothergroceryapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "YetAnotherGroceryApp uses the camera to scan barcodes and capture shelf prices and receipts.",
        "NSPhotoLibraryUsageDescription": "YetAnotherGroceryApp can access your photo library to import product, shelf, and receipt photos."
      }
    },
    "android": {
      "package": "com.yetanothergroceryapp.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "15bd877b-8763-4ff6-9189-f51a6ec41924"
      }
    },
    "owner": "genegulanesjrs-team",
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "YetAnotherGroceryApp can access your photo library to import product photos."
        }
      ]
    ]
  }
}
