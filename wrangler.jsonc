// Landing page for yaga, served as static assets by the `yetanothergroceryapp`
// Worker. Cloudflare Workers Builds runs `npx wrangler versions upload` from
// the repository root, so this file must live here. The web dashboard is a
// separate Pages project (see web-desktop/wrangler.jsonc).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "yetanothergroceryapp",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./site"
  }
}
