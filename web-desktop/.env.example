# Target: "web" (default, Node.js runtime) or "desktop" (static export for Tauri).
APP_TARGET=web

# Public Clerk publishable key (auth). Generate at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Shared backend API base URL used by the typed api-client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
