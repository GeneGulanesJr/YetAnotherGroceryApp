# Port the HTTP server listens on.
PORT=8787

# SQLite database location. `file:` URLs (and bare paths / `:memory:`) use the
# local better-sqlite3 driver. libsql:// / https:// URLs require the Turso
# driver swap documented in README.md ("Switching to Turso/libSQL") and are
# rejected until that driver is installed.
DATABASE_URL=file:local.db

# Value for the CORS Access-Control-Allow-Origin header. Empty = allow all
# (development). Set to an explicit origin in deployment.
ALLOWED_ORIGIN=
